# ⚙️ CONFIGURAZIONE FRONTEND HYPERGYM
# Copia questo file in .env e inserisci i parametri del tuo progetto Supabase

# Backend API URL (opzionale per auto-rilevamento)
# VITE_API_URL=http://localhost:8000

# ⚙️ SUPABASE CREDENTIALS (Inserisci i parametri del tuo progetto Supabase per HyperGym)
VITE_SUPABASE_URL=https://tuo-progetto.supabase.co
VITE_SUPABASE_ANON_KEY=tua-chiave-anon-supabase
